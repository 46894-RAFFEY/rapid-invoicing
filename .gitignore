# .gitignore for Rapid Invoicing System

# Frontend
node_modules/
dist/
build/
.next
out/
.expo/
.env.local
.env.*.local

# Frontend build artifacts
*.js.map
*.css.map
.parcel-cache/
.cache/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backend
backend/vendor/
backend/composer.lock
backend/.env
backend/.env.local
backend/.env.*.php

# Database
backend/database/*.sql
!backend/database/schema.sql
!backend/database/backup.sql

# PHP
*.phtml
.phpunit.result.cache

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.swp

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln

# Package managers
yarn.lock
package-lock.json

# Environment variables
.env
.env.example
.env.*.local

# Testing
coverage/
.nyc_output/

# Build output
dist/
build/
out/

# Deployment
.vercel/
.netlify/
